{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniintel.local/schemas/execution-plan.schema.json",
  "title": "OmniIntel Local Execution Plan",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "read_only": {"const": true},
    "ready_for_execution": {"type": "boolean"},
    "total_bytes": {"type": "integer", "minimum": 0},
    "questions": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 255},
          "modality": {"enum": ["DOCUMENT", "AUDIO", "VIDEO", "IMAGE", "CAPTIONS"]},
          "media_type": {"type": "string", "minLength": 1},
          "byte_size": {"type": "integer", "minimum": 1},
          "modified_ns": {"type": "integer", "minimum": 0},
          "file_id": {"type": "integer", "minimum": 0},
          "action": {"type": "string", "minLength": 1},
          "resource_class": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "network": {"const": "none"},
          "requires_user_review": {"type": "boolean"}
        },
        "required": ["path", "display_name", "modality", "media_type", "byte_size",
          "modified_ns", "file_id", "action", "resource_class", "network", "requires_user_review"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "read_only", "ready_for_execution", "total_bytes",
    "questions", "warnings", "inputs"],
  "additionalProperties": false
}