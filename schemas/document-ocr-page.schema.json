{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniintel.local/schemas/document-ocr-page.schema.json",
  "title": "OmniIntel OCR Page",
  "type": "object",
  "properties": {
    "page_id": { "$ref": "common.schema.json#/$defs/uuid7" },
    "rendered_asset_id": { "$ref": "common.schema.json#/$defs/uuid7" },
    "engine_name": { "type": "string", "minLength": 1 },
    "engine_version": { "type": "string", "minLength": 1 },
    "text_content": { "type": "string" },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "x0": { "type": "number", "minimum": 0, "maximum": 1 },
          "y0": { "type": "number", "minimum": 0, "maximum": 1 },
          "x1": { "type": "number", "minimum": 0, "maximum": 1 },
          "y1": { "type": "number", "minimum": 0, "maximum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 100 }
        },
        "required": ["text","x0","y0","x1","y1","confidence"],
        "additionalProperties": false
      }
    },
    "mean_confidence": { "type": ["number","null"], "minimum": 0, "maximum": 100 },
    "status": { "enum": ["NEEDS_REVIEW","ACCEPTED","REJECTED","EMPTY","FAILED"] },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "required": ["page_id","rendered_asset_id","engine_name","engine_version","text_content","words","mean_confidence","status","created_at"],
  "unevaluatedProperties": false
}
