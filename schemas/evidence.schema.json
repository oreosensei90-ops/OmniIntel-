{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniintel.local/schemas/evidence.schema.json",
  "title": "OmniIntel Evidence Item",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid7"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "deleted_at": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_id": {
      "$ref": "common.schema.json#/$defs/uuid7"
    },
    "evidence_type": {
      "enum": [
        "transcript",
        "caption",
        "slide_text",
        "diagram",
        "equation",
        "code",
        "whiteboard",
        "visual_observation",
        "external_reference"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "start_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "end_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "asset_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid7"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "enum": [
        "SOURCE",
        "EXPLANATION",
        "DERIVED",
        "EXTERNAL",
        "UNCERTAIN"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "source_id",
    "evidence_type",
    "content",
    "start_ms",
    "end_ms",
    "asset_id",
    "provenance",
    "confidence"
  ],
  "additionalProperties": false
}
