{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniintel.local/schemas/document-topic.schema.json",
  "title": "OmniIntel Document Topic",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/uuid7" },
    "source_id": { "$ref": "common.schema.json#/$defs/uuid7" },
    "parent_topic_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid7" }, { "type": "null" }] },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "ordinal": { "type": "integer", "minimum": 0 },
    "provenance": { "enum": ["EXPLANATION", "DERIVED", "UNCERTAIN"] },
    "status": { "enum": ["DRAFT", "NEEDS_REVIEW", "ACCEPTED", "REJECTED"] },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "required": ["id", "source_id", "parent_topic_id", "title", "description", "ordinal", "provenance", "status", "confidence", "created_at", "updated_at"],
  "unevaluatedProperties": false
}
