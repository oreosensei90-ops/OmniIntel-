{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniintel.local/schemas/job.schema.json",
  "title": "OmniIntel Job",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid7"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "deleted_at": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "job_type": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "SUBMITTED",
        "QUEUED",
        "RUNNING",
        "PAUSED",
        "WAITING_FOR_RESOURCES",
        "WAITING_FOR_USER",
        "RETRYING",
        "PARTIALLY_COMPLETED",
        "FAILED",
        "CANCELLED",
        "COMPLETED"
      ]
    },
    "payload": {
      "type": "object"
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "progress": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "last_error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "job_type",
    "state",
    "payload",
    "attempt_count",
    "max_attempts",
    "idempotency_key",
    "progress",
    "last_error"
  ],
  "unevaluatedProperties": false
}
