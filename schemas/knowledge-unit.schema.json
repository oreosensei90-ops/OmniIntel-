{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniintel.local/schemas/knowledge-unit.schema.json",
  "title": "OmniIntel Knowledge Unit",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid7"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "deleted_at": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_element_id": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/uuid7" },
        { "type": "null" }
      ]
    },
    "unit_type": {
      "enum": [
        "concept",
        "definition",
        "principle",
        "formula",
        "procedure",
        "example",
        "worked_solution",
        "observation",
        "comparison",
        "warning",
        "question",
        "reference"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "enum": [
        "EXPLANATION",
        "DERIVED",
        "UNCERTAIN"
      ]
    },
    "status": {
      "enum": [
        "DRAFT",
        "VALIDATED",
        "NEEDS_REVIEW",
        "REJECTED"
      ]
    }
  },
  "required": [
    "id",
    "schema_version",
    "created_at",
    "updated_at",
    "revision",
    "unit_type",
    "title",
    "body",
    "provenance",
    "status"
  ],
  "unevaluatedProperties": false
}
