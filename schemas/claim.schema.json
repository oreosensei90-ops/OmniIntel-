{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniintel.local/schemas/claim.schema.json",
  "title": "OmniIntel Claim",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid7"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "deleted_at": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "knowledge_unit_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid7"
        },
        {
          "type": "null"
        }
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "enum": [
        "EXPLANATION",
        "DERIVED",
        "UNCERTAIN"
      ]
    },
    "status": {
      "enum": [
        "DRAFT",
        "SUPPORTED",
        "CONTESTED",
        "UNCERTAIN",
        "REJECTED"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "id",
    "schema_version",
    "created_at",
    "updated_at",
    "revision",
    "knowledge_unit_id",
    "statement",
    "provenance",
    "status",
    "confidence"
  ],
  "unevaluatedProperties": false
}
