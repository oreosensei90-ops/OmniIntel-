{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniintel.local/schemas/quality-benchmark-report.schema.json",
  "title": "OmniIntel Deterministic Quality Benchmark Report",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "case_count": {"type": "integer", "minimum": 1},
    "aggregates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "mean": {"type": "number"},
          "count": {"type": "integer", "minimum": 1}
        },
        "required": ["mean", "count"],
        "additionalProperties": false
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "metrics": {"type": "object"}
        },
        "required": ["case_id", "metrics"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "case_count", "aggregates", "cases"],
  "additionalProperties": false
}