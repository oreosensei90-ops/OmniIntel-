# Copy this file to deploy/cloud-worker.env and replace the token placeholder.
# Never commit the real cloud-worker.env file or paste the token into chat.
OMNIINTEL_WORKER_API=https://omniintel-api.scrbaba502.workers.dev
OMNIINTEL_WORKER_TOKEN=replace-with-the-same-worker-bridge-token
OMNIINTEL_POLL_SECONDS=5

# Local transcription. The first start downloads the model into the persistent volume.
OMNIINTEL_ASR_MODEL_ID=small
OMNIINTEL_ASR_ALLOW_MODEL_DOWNLOAD=1
OMNIINTEL_ASR_DEVICE=cpu
OMNIINTEL_ASR_COMPUTE_TYPE=int8
OMNIINTEL_ASR_THREADS=4

# AI is only used for jobs with explicit AI consent.
OMNIINTEL_AI_PROVIDER=gemini
OMNIINTEL_GEMINI_MODEL=gemini-2.5-flash
OMNIINTEL_GEMINI_API_KEY=
# Optional alternative provider credentials (only used when explicitly selected).
OMNIINTEL_OPENAI_MODEL=gpt-4.1-mini
OMNIINTEL_OPENAI_API_KEY=
