# Copy to .env and replace every placeholder. Never commit your real .env.
OMNIINTEL_API_TOKEN=replace-with-a-long-random-secret
OMNIINTEL_OPENAI_API_KEY=replace-with-your-server-side-provider-key
OMNIINTEL_OPENAI_MODEL=gpt-4.1-mini
OMNIINTEL_CORS_ORIGINS=https://your-web-app.example
OMNIINTEL_PORT=8000
OMNIINTEL_ASR_MODEL_HOST_PATH=./models/faster-whisper-small
OMNIINTEL_ASR_DEVICE=cpu
OMNIINTEL_ASR_COMPUTE_TYPE=int8
OMNIINTEL_ASR_THREADS=4
